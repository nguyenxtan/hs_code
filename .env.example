# Optional PostgreSQL. Leave empty to read the prepared local snapshot.
DATABASE_URL=
HS_SNAPSHOT_PATH=data/processed/2026-11-03/snapshot.json

# No Codex/ChatGPT sign-in credentials. Local embeddings require no API key.
HS_EMBEDDINGS_ENABLED=false
HS_EMBEDDINGS_PATH=.cache/embeddings.json
HS_EMBEDDING_MODEL=Xenova/multilingual-e5-small

# Optional free OpenRouter assistant. Keep the real key only in .env.local.
HS_CHAT_ENABLED=false
OPENROUTER_API_KEY=
HS_CHAT_MODEL=nvidia/nemotron-3.5-super-vl:free
HS_CHAT_DAILY_LIMIT=200
# UTC daily process budget; resets at 07:00 Vietnam time. Upstream quota also applies.
# Fixed OpenRouter endpoint; no paid model fallback. Key alone never activates AI.
